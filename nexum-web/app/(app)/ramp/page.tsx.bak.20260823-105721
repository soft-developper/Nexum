function WithdrawCard({ liq }: { liq: RampLiquidationAddress }) {
  const [amount, setAmount]   = useState('')
  const [sending, setSending] = useState(false)
  const [step, setStep]       = useState<string | null>(null)
  const [txHash, setTxHash]   = useState<string | null>(null)
  const [sent, setSent]       = useState(false)
  const [err, setErr]         = useState<string | null>(null)

  const amt = Number(amount)
  const valid = Number.isFinite(amt) && amt >= 1   // Bridge min: amount − fee > $1 (0% fee at launch)

  const submit = async () => {
    setErr(null)
    if (!valid) { setErr('Enter an amount of at least 1 USDC.'); return }
    setSending(true); setSent(false); setStep(null)
    try {
      // The exact same Circle-signed send path as multichain send — USDC leaves
      // the user's wallet on Base and lands at the Bridge liquidation address,
      // which auto-converts it to fiat and pays out to their bank.
      const result = await sendUsdc(
        { to: liq.address, amount: String(amt), chainKey: liq.sourceChain },
        setStep,
      )
      if (result.txHash) {
        setTxHash(result.txHash)
        const st = String(result.state ?? '').toUpperCase()
        if (st !== 'FAILED' && st !== 'DENIED') setSent(true)
      } else {
        setSent(true)
      }
    } catch (e: any) {
      if (e instanceof UserCancelledError) { setErr('You cancelled the withdrawal. Nothing was sent.') }
      else if (e instanceof NeedsReauthError) { setErr('Your session expired — please sign in again to withdraw.') }
      else { setErr(e?.message ?? 'Could not complete the withdrawal.') }
    } finally {
      setSending(false); setStep(null)
    }
  }

  if (sent) {
    return (
      <div className="space-y-4 rounded-2xl border border-app-border bg-app-surface p-5">
        <div className="flex items-center gap-2.5 text-app-text">
          <span className="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-500/15">
            <CircleCheck className="h-5 w-5 text-emerald-400" />
          </span>
          <div>
            <p className="font-medium">Withdrawal sent</p>
            <p className="text-sm text-app-muted">
              {amount} USDC is on its way to your bank. Track it below.
            </p>
          </div>
        </div>
        {txHash && (
          <a href={`https://sepolia.basescan.org/tx/${txHash}`} target="_blank" rel="noopener noreferrer"
            className="inline-flex items-center gap-1 text-xs text-app-accent-text hover:underline">
            View transaction <ExternalLink className="h-3 w-3" />
          </a>
        )}
        <Button variant="outline" className="w-full" onClick={() => { setSent(false); setAmount(''); setTxHash(null) }}>
          Make another withdrawal
        </Button>
      </div>
    )
  }

  return (
    <div className="space-y-4 rounded-2xl border border-app-border bg-app-surface p-5">
      <div className="flex items-center gap-2 text-app-text">
        <SendIcon className="h-4 w-4 text-app-accent-text" />
        <span className="text-sm font-medium">Amount to withdraw</span>
      </div>

      <div className="space-y-1.5">
        <div className="relative">
          <Input
            inputMode="decimal"
            placeholder="0.00"
            value={amount}
            onChange={e => setAmount(e.target.value)}
            className="pr-16 text-lg"
          />
          <span className="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-sm font-medium text-app-muted">
            USDC
          </span>
        </div>
        <p className="text-[11px] text-app-muted">
          Sent from your wallet on Base. You&rsquo;ll receive {liq.destinationCurrency.toUpperCase()} in your linked account.
        </p>
      </div>

      {/* Where it goes */}
      <div className="flex items-start gap-2.5 rounded-xl border border-app-border/60 bg-app-bg p-3.5 text-sm">
        <Landmark className="mt-0.5 h-4 w-4 shrink-0 text-app-accent-text" />
        <div className="min-w-0">
          <p className="text-app-text">Paid out to your linked bank account</p>
          <p className="text-[11px] text-app-muted">
            No fees at launch. Bank payout times vary by rail.
          </p>
        </div>
      </div>

      {step && (
        <div className="flex items-center gap-2 rounded-lg bg-app-bg px-3 py-2 text-xs text-app-muted">
          <Loader2 className="h-3.5 w-3.5 animate-spin" /> {step}
        </div>
      )}
      {err && <ErrorNote text={err} />}

      <Button className="w-full" size="lg" disabled={sending || !valid} onClick={submit}>
        {sending
          ? <><Loader2 className="h-4 w-4 animate-spin" /> Sending…</>
          : <>Withdraw {valid ? `${amt} ` : ''}USDC <ArrowRight className="h-4 w-4" /></>}
      </Button>
    </div>
  )
}

// ── Drain (payout) status tracker — mirrors the deposit tracker ────────────

const DRAIN_STEPS = [
  { key: 'sent',      label: 'USDC sent',            match: [] as string[] },
  { key: 'received',  label: 'Received by partner',  match: ['funds_received'] },
  { key: 'submitted', label: 'Paying out to bank',   match: ['payment_submitted'] },
  { key: 'processed', label: 'Arrived in your bank', match: ['payment_processed'] },
]

const DRAIN_FAILURE_STATES = ['undeliverable', 'returned', 'error', 'canceled']

function drainStageIndex(drain: RampDrain | null): number {
  if (!drain) return 0
  let idx = 1 // a drain exists → at least "received" is in flight
  for (let s = DRAIN_STEPS.length - 1; s >= 1; s--) {
    if (DRAIN_STEPS[s].match.includes(drain.state)) { idx = Math.max(idx, s); break }
  }
  if (drain.state === 'payment_processed') idx = DRAIN_STEPS.length - 1
  return idx
}

function DrainTracker({ currency }: { currency: string }) {
  const { getDrains } = useOfframp()
  const [drains, setDrains]   = useState<RampDrain[]>([])
  const [loading, setLoading] = useState(true)
  const [refreshing, setRefreshing] = useState(false)
  const timer = useRef<ReturnType<typeof setInterval> | null>(null)

  const pull = async () => {
    const r = await getDrains(currency)
    if (r) setDrains(r.drains)
    setLoading(false)
  }

  useEffect(() => {
    pull()
    timer.current = setInterval(pull, 15000)
    const onFocus = () => pull()
    window.addEventListener('focus', onFocus)
    return () => {
      if (timer.current) clearInterval(timer.current)
      window.removeEventListener('focus', onFocus)
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [currency])

  const manualRefresh = async () => { setRefreshing(true); await pull(); setRefreshing(false) }

  // Most recent drain drives the tracker.
  const latest = drains.length > 0 ? drains[0] : null
  const idx = drainStageIndex(latest)
  const processed = latest?.state === 'payment_processed'
  const failed = latest && DRAIN_FAILURE_STATES.includes(latest.state)

  return (
    <div className="space-y-4 rounded-2xl border border-app-border bg-app-surface p-5">
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-2 text-app-text">
          <Clock className="h-4 w-4 text-app-accent-text" />
          <span className="text-sm font-medium">Withdrawal status</span>
        </div>
        <button onClick={manualRefresh} disabled={refreshing}
          className="inline-flex items-center gap-1 text-[11px] text-app-muted transition-colors hover:text-app-text disabled:opacity-50">
          <RefreshCw className={`h-3 w-3 ${refreshing ? 'animate-spin' : ''}`} /> Refresh
        </button>
      </div>

      {loading ? (
        <div className="h-28 animate-pulse rounded-lg bg-app-bg" />
      ) : failed ? (
        <StatusBanner
          tone={latest?.state === 'canceled' ? 'info' : 'failed'}
          title={
            latest?.state === 'returned'      ? 'Payout returned'
          : latest?.state === 'undeliverable' ? 'Couldn’t reach your bank'
          : latest?.state === 'canceled'      ? 'Withdrawal canceled'
          : 'Withdrawal problem'}
          body={
            latest?.state === 'returned'      ? 'Your bank returned this payout. The USDC has been sent back to your wallet.'
          : latest?.state === 'undeliverable' ? 'We couldn’t deliver to the linked account. Please check the details or contact support.'
          : latest?.state === 'canceled'      ? 'This withdrawal was canceled before payout. No funds left your wallet, or they were returned.'
          : 'Something went wrong with this payout. Please contact support so we can help.'}
        />
      ) : (
        <ol className="relative space-y-4">
          {DRAIN_STEPS.map((stp, i) => {
            const done    = i < idx || (processed && i <= idx)
            const current = i === idx && !processed
            return (
              <li key={stp.key} className="flex items-start gap-3">
                <span className="relative flex flex-col items-center">
                  <span className={`flex h-6 w-6 items-center justify-center rounded-full border text-[11px] ${
                    done
                      ? 'border-emerald-500 bg-emerald-500 text-white'
                      : current
                        ? 'border-app-accent bg-app-accent/15 text-app-accent-text'
                        : 'border-app-border text-app-muted'}`}>
                    {done ? <Check className="h-3.5 w-3.5" />
                          : current ? <Loader2 className="h-3 w-3 animate-spin" />
                          : i + 1}
                  </span>
                  {i < DRAIN_STEPS.length - 1 && (
                    <span className={`mt-1 h-6 w-px ${i < idx ? 'bg-emerald-500/60' : 'bg-app-border'}`} />
                  )}
                </span>
                <div className="pt-0.5">
                  <p className={`text-sm ${done || current ? 'text-app-text' : 'text-app-muted'}`}>
                    {stp.label}
                  </p>
                  {current && i === 0 && (
                    <p className="text-[11px] text-app-muted">
                      Send USDC above to start your withdrawal.
                    </p>
                  )}
                </div>
              </li>
            )
          })}
        </ol>
      )}

      {processed && latest?.destination_tx_hash && (
        <p className="text-[11px] text-app-muted">
          Paid out{latest.destination?.trace_number ? ` · trace ${latest.destination.trace_number}` : ''}
          {latest.destination?.imad ? ` · IMAD ${latest.destination.imad}` : ''}.
        </p>
      )}

      {!loading && drains.length === 0 && (
        <p className="text-[11px] text-app-muted">
          No withdrawals yet. Once you send USDC, they&rsquo;ll show here.
        </p>
      )}
    </div>
  )
}


// ═══════════════════════════════════════════════════════════════════════════
// On-ramp flow (verified users). Currency grid → confirm → deposit details +
// status tracker. Deposits land as USDC on Base in the user's Circle wallet.
// ═══════════════════════════════════════════════════════════════════════════

const CURRENCY_META: Record<string, { flag: string; name: string; rail: string }> = {
  usd: { flag: '🇺🇸', name: 'US Dollar',      rail: 'ACH or wire transfer' },
  eur: { flag: '🇪🇺', name: 'Euro',           rail: 'SEPA transfer' },
  gbp: { flag: '🇬🇧', name: 'British Pound',   rail: 'Faster Payments' },
  mxn: { flag: '🇲🇽', name: 'Mexican Peso',    rail: 'SPEI transfer' },
  brl: { flag: '🇧🇷', name: 'Brazilian Real',  rail: 'Pix' },
  cop: { flag: '🇨🇴', name: 'Colombian Peso',  rail: 'Bre-B' },
}

function meta(code: string) {
  return CURRENCY_META[code] ?? { flag: '🏦', name: code.toUpperCase(), rail: 'Bank transfer' }
}

type Stage = 'pick' | 'confirm' | 'details'

function OnrampFlow() {
  const {
    corridors, corridorsLoading, findVirtualAccount, endorsementFor,
    creating, error, createVirtualAccount, loadVirtualAccounts,
  } = useOnramp()

  const [stage, setStage]       = useState<Stage>('pick')
  const [selected, setSelected] = useState<string | null>(null)
  const [account, setAccount]   = useState<RampVirtualAccount | null>(null)

  const pick = (currency: string) => {
    // Only enabled (approved) currencies are selectable; guard anyway.
    if (endorsementFor(currency) !== 'approved') return
    setSelected(currency)
    // If a rail already exists for this currency, jump straight to details.
    const existing = findVirtualAccount(currency)
    if (existing) { setAccount(existing); setStage('details') }
    else setStage('confirm')
  }

  const confirm = async () => {
    if (!selected) return
    const va = await createVirtualAccount(selected)
    if (va) { setAccount(va); setStage('details') }
  }

  const back = () => {
    if (stage === 'details') { setStage('pick'); setAccount(null); setSelected(null); loadVirtualAccounts() }
    else { setStage('pick'); setSelected(null) }
  }

  if (stage === 'details' && account) {
    return <DepositDetails account={account} onBack={back} />
  }

  if (stage === 'confirm' && selected) {
    const m = meta(selected)
    return (
      <div className="w-full max-w-lg">
        <button onClick={back}
          className="mb-4 inline-flex items-center gap-1 text-sm text-app-muted transition-colors hover:text-app-text">
          <ChevronLeft className="h-4 w-4" /> Back
        </button>
        <div className="space-y-5 rounded-2xl border border-app-border bg-app-surface p-6">
          <div className="flex items-center gap-3">
            <span className="text-3xl leading-none" aria-hidden>{m.flag}</span>
            <div>
              <p className="font-medium text-app-text">Deposit {m.name}</p>
              <p className="text-sm text-app-muted">Fund with {m.rail}</p>
            </div>
          </div>

          <div className="space-y-3 rounded-xl bg-app-bg p-4 text-sm">
            <Step n={1} text={`We'll give you ${selected.toUpperCase()} bank details in your name.`} />
            <Step n={2} text={`Send ${selected.toUpperCase()} to those details from your bank, any time.`} />
            <Step n={3} text="It arrives as USDC in your wallet on Base, automatically." />
          </div>

          <div className="flex items-center gap-2 rounded-lg border border-app-border/60 bg-app-bg px-3 py-2 text-xs text-app-muted">
            <ShieldCheck className="h-4 w-4 shrink-0 text-app-accent-text" />
            No fees at launch. Creating deposit details doesn&rsquo;t move any money.
          </div>

          {error && <ErrorNote text={error} />}

          <Button className="w-full" size="lg" disabled={creating} onClick={confirm}>
            {creating
              ? <><Loader2 className="h-4 w-4 animate-spin" /> Setting up…</>
              : <>Get deposit details <ArrowRight className="h-4 w-4" /></>}
          </Button>
        </div>
      </div>
    )
  }

  // stage === 'pick'
  return (
    <div className="w-full max-w-lg">
      <div className="mb-4">
        <h2 className="text-sm font-medium text-app-text">Add money</h2>
        <p className="text-sm text-app-muted">Choose the currency you&rsquo;ll deposit from your bank.</p>
      </div>

      {corridorsLoading ? (
        <div className="grid grid-cols-2 gap-3 sm:grid-cols-3">
          {Array.from({ length: 6 }).map((_, i) => (
            <div key={i} className="h-24 animate-pulse rounded-xl border border-app-border bg-app-surface" />
          ))}
        </div>
      ) : corridors.length === 0 ? (
        <div className="rounded-2xl border border-app-border bg-app-surface p-6 text-sm text-app-muted">
          No deposit currencies are available right now. Please check back soon.
        </div>
      ) : (
        <div className="grid grid-cols-2 gap-3 sm:grid-cols-3">
          {corridors.map((c: RampCorridor) => {
            const m = meta(c.currency)
            const has = !!findVirtualAccount(c.currency)
            const endo = endorsementFor(c.currency)
            const enabled = endo === 'approved'
            return (
              <button key={c.currency}
                onClick={() => pick(c.currency)}
                disabled={!enabled}
                aria-disabled={!enabled}
                className={`group relative flex flex-col items-start gap-2 rounded-xl border p-4 text-left transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-app-accent/50 ${
                  enabled
                    ? 'border-app-border bg-app-surface hover:border-app-accent/60 hover:bg-app-bg cursor-pointer'
                    : 'border-app-border/60 bg-app-surface/50 cursor-not-allowed'}`}>
                <span className={`text-2xl leading-none ${enabled ? '' : 'opacity-40 grayscale'}`} aria-hidden>{m.flag}</span>
                <span className={`text-sm font-medium ${enabled ? 'text-app-text' : 'text-app-muted'}`}>{c.currency.toUpperCase()}</span>
                <span className="text-[11px] leading-tight text-app-muted">{m.name}</span>
                {enabled && has && (
                  <span className="absolute right-2 top-2 flex items-center gap-0.5 rounded-full bg-emerald-900/40 px-1.5 py-0.5 text-[9px] font-medium text-emerald-400">
                    <Check className="h-2.5 w-2.5" /> Ready
                  </span>
                )}
                {enabled && !has && (
                  <ArrowRight className="absolute bottom-3 right-3 h-4 w-4 text-app-muted opacity-0 transition-opacity group-hover:opacity-100" />
                )}
                {!enabled && (
                  <span className="absolute right-2 top-2 rounded-full bg-app-border px-1.5 py-0.5 text-[9px] font-medium text-app-muted">
                    {endo === 'pending' ? 'In review' : 'Soon'}
                  </span>
                )}
              </button>
            )
          })}
        </div>
      )}

      {!corridorsLoading && corridors.some(c => endorsementFor(c.currency) !== 'approved') && (
        <p className="mt-3 flex items-start gap-1.5 text-[11px] text-app-muted">
          <AlertCircle className="mt-0.5 h-3 w-3 shrink-0" />
          Greyed-out currencies need extra approval from our payments partner before you can deposit them. We&rsquo;re working on it.
        </p>
      )}
    </div>
  )
}

function Step({ n, text }: { n: number; text: string }) {
  return (
    <div className="flex items-start gap-2.5">
      <span className="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-app-accent/15 text-[11px] font-semibold text-app-accent-text">
        {n}
      </span>
      <span className="text-app-text">{text}</span>
    </div>
  )
}

function ErrorNote({ text }: { text: string }) {
  return (
    <div className="flex items-start gap-1.5 rounded-lg bg-red-900/20 px-3 py-2 text-xs text-red-400">
      <AlertCircle className="mt-0.5 h-3.5 w-3.5 shrink-0" />
      <span>{text}</span>
    </div>
  )
}

// ── Deposit details + status tracker ───────────────────────────────────────

// Field order per currency: only the fields Bridge returns for that currency
// are shown. Labels are user-facing (what they'll type into their bank).
const FIELD_LABELS: Record<string, string> = {
  bank_name:             'Bank name',
  bank_address:          'Bank address',
  bank_routing_number:   'Routing number',
  bank_account_number:   'Account number',
  bank_beneficiary_name: 'Beneficiary name',
  bank_beneficiary_address: 'Beneficiary address',
  iban:                  'IBAN',
  bic:                   'BIC / SWIFT',
  account_holder_name:   'Account holder',
  clabe:                 'CLABE',
  br_code:               'Pix code',
  account_number:        'Account number',
  sort_code:             'Sort code',
}
const FIELD_ORDER = [
  'bank_beneficiary_name', 'account_holder_name',
  'iban', 'bic',
  'account_number', 'sort_code', 'clabe', 'br_code',
  'bank_account_number', 'bank_routing_number',
  'bank_name', 'bank_address', 'bank_beneficiary_address',
]

function orderedFields(di: DepositInstructions): Array<[string, string]> {
  const out: Array<[string, string]> = []
  for (const key of FIELD_ORDER) {
    const v = di[key]
    if (typeof v === 'string' && v.trim()) out.push([key, v])
  }
  return out
}

function DepositDetails({ account, onBack }: { account: RampVirtualAccount; onBack: () => void }) {
  const m = meta(account.currency)
  const di = account.depositInstructions ?? {}
  const fields = orderedFields(di)
  const rails = Array.isArray(di.payment_rails) ? di.payment_rails : []

  return (
    <div className="w-full max-w-lg">
      <button onClick={onBack}
        className="mb-4 inline-flex items-center gap-1 text-sm text-app-muted transition-colors hover:text-app-text">
        <ChevronLeft className="h-4 w-4" /> All currencies
      </button>

      <div className="space-y-4">
        {/* Header */}
        <div className="flex items-center justify-between rounded-2xl border border-app-border bg-app-surface p-5">
          <div className="flex items-center gap-3">
            <span className="text-3xl leading-none" aria-hidden>{m.flag}</span>
            <div>
              <p className="font-medium text-app-text">Deposit {m.name}</p>
              <p className="text-sm text-app-muted">Arrives as USDC on Base</p>
            </div>
          </div>
          <Badge variant="success">Ready</Badge>
        </div>

        {/* Deposit instructions */}
        <div className="space-y-3 rounded-2xl border border-app-border bg-app-surface p-5">
          <div className="flex items-center gap-2 text-app-text">
            <Landmark className="h-4 w-4 text-app-accent-text" />
            <span className="text-sm font-medium">Send {account.currency.toUpperCase()} to these details</span>
          </div>

          {fields.length === 0 ? (
            <p className="rounded-lg bg-app-bg px-3 py-4 text-center text-xs text-app-muted">
              Deposit details are being generated. Pull to refresh in a moment.
            </p>
          ) : (
            <div className="divide-y divide-app-border/60 overflow-hidden rounded-xl border border-app-border/60">
              {fields.map(([key, value]) => (
                <CopyRow key={key} label={FIELD_LABELS[key] ?? key} value={value} />
              ))}
            </div>
          )}

          {rails.length > 0 && (
            <div className="flex flex-wrap items-center gap-1.5 pt-1">
              <span className="text-[11px] text-app-muted">Accepts:</span>
              {rails.map(r => (
                <span key={r} className="rounded-full bg-app-bg px-2 py-0.5 text-[10px] font-medium text-app-muted">
                  {String(r).replace(/_/g, ' ')}
                </span>
              ))}
            </div>
          )}
        </div>

        {/* Where it lands */}
        <div className="flex items-start gap-2.5 rounded-2xl border border-app-border bg-app-surface p-4 text-sm">
          <Wallet className="mt-0.5 h-4 w-4 shrink-0 text-app-accent-text" />
          <div className="min-w-0">
            <p className="text-app-text">Delivered to your wallet on Base</p>
            <p className="truncate font-mono text-[11px] text-app-muted">{account.destinationAddress}</p>
          </div>
        </div>

        {/* Status tracker */}
        <DepositTracker currency={account.currency} />
      </div>
    </div>
  )
}

function CopyRow({ label, value }: { label: string; value: string }) {
  const [copied, setCopied] = useState(false)
  const copy = async () => {
    try {
      await navigator.clipboard.writeText(value)
      setCopied(true)
      setTimeout(() => setCopied(false), 1500)
    } catch { /* clipboard blocked; ignore */ }
  }
  return (
    <button onClick={copy}
      className="flex w-full items-center justify-between gap-3 bg-app-surface px-3 py-2.5 text-left transition-colors hover:bg-app-bg">
      <span className="min-w-0">
        <span className="block text-[11px] uppercase tracking-wide text-app-muted">{label}</span>
        <span className="block truncate font-mono text-sm text-app-text">{value}</span>
      </span>
      <span className={`flex shrink-0 items-center gap-1 text-[11px] ${copied ? 'text-emerald-400' : 'text-app-muted'}`}>
        {copied ? <><Check className="h-3.5 w-3.5" /> Copied</> : <><Copy className="h-3.5 w-3.5" /> Copy</>}
      </span>
    </button>
  )
}

// Ordered happy-path lifecycle. Bridge event types map onto these stages.
// Edge states (in_review / refund* / microdeposit) are handled separately
// below — they are NOT steps, they change the whole status of the deposit.
const TRACKER_STEPS = [
  { key: 'awaiting',  label: 'Waiting for your deposit', match: [] as string[] },
  { key: 'received',  label: 'Funds received',           match: ['funds_received'] },
  { key: 'submitted', label: 'Converting to USDC',       match: ['payment_submitted'] },
  { key: 'delivered', label: 'USDC delivered',           match: ['payment_processed'] },
]

// Event types that describe the ACCOUNT, not a deposit's progress — ignored.
const LIFECYCLE_TYPES = ['account_update', 'deactivation', 'activation']

function stageIndexFor(events: RampActivityEvent[]): number {
  let idx = 0
  for (const ev of events) {
    for (let s = TRACKER_STEPS.length - 1; s >= 1; s--) {
      if (TRACKER_STEPS[s].match.includes(ev.type) && s > idx) idx = s
    }
  }
  return idx
}

// The deposit's overall disposition, derived from the events present. A refund
// (in any form) or an in_review hold overrides the happy stepper, because the
// funds won't simply proceed to delivery.
type Disposition =
  | { kind: 'normal' }
  | { kind: 'in_review' }
  | { kind: 'returned'; failed: boolean; reason?: string }
  | { kind: 'microdeposit' }

function dispositionFor(events: RampActivityEvent[]): Disposition {
  const has = (t: string) => events.some(e => e.type === t)
  // A completed delivery always wins — even if an earlier review cleared.
  if (has('payment_processed')) return { kind: 'normal' }
  if (has('refund') || has('refund_in_flight') || has('refund_failed')) {
    const failed = has('refund_failed')
    const refundEv = [...events].reverse().find(e =>
      e.type === 'refund' || e.type === 'refund_in_flight' || e.type === 'refund_failed')
    const reason = (refundEv as any)?.refund?.reason ?? (refundEv as any)?.reason
    return { kind: 'returned', failed, reason: typeof reason === 'string' ? reason : undefined }
  }
  if (has('in_review')) return { kind: 'in_review' }
  // Only microdeposits and nothing else → verification, not a real deposit.
  const meaningful = events.filter(e => !LIFECYCLE_TYPES.includes(e.type))
  if (meaningful.length > 0 && meaningful.every(e => e.type === 'microdeposit')) {
    return { kind: 'microdeposit' }
  }
  return { kind: 'normal' }
}

function StatusBanner({ tone, title, body }: {
  tone: 'review' | 'returned' | 'failed' | 'info'
  title: string
  body: string
}) {
  const styles: Record<string, string> = {
    review:   'border-amber-500/40 bg-amber-900/15 text-amber-300',
    returned: 'border-orange-500/40 bg-orange-900/15 text-orange-300',
    failed:   'border-red-500/40 bg-red-900/15 text-red-300',
    info:     'border-app-border bg-app-bg text-app-muted',
  }
  const Icon = tone === 'failed' ? AlertCircle : tone === 'review' ? Clock : ArrowDownUp
  return (
    <div className={`flex items-start gap-2.5 rounded-xl border px-3 py-3 text-sm ${styles[tone]}`}>
      <Icon className="mt-0.5 h-4 w-4 shrink-0" />
      <div>
        <p className="font-medium">{title}</p>
        <p className="mt-0.5 text-[13px] opacity-90">{body}</p>
      </div>
    </div>
  )
}

// Format a Bridge decimal-string amount for display. Returns null if absent.
function fmtAmount(v: unknown): string | null {
  if (typeof v !== 'string' || !v.trim()) return null
  const n = Number(v)
  if (!Number.isFinite(n)) return null
  return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })
}

function sumFees(ev?: RampActivityEvent): number {
  if (!ev) return 0
  const dev = Number(ev.developer_fee_amount ?? ev.receipt?.developer_fee ?? 0)
  const exc = Number(ev.exchange_fee_amount ?? ev.receipt?.exchange_fee ?? 0)
  return (Number.isFinite(dev) ? dev : 0) + (Number.isFinite(exc) ? exc : 0)
}

// Live sent → fees → received breakdown. Fills in as events arrive. `sent`
// comes from the source-currency event (funds_received); `received` from the
// destination event (payment_processed, whose amount is the USDC delivered).
function DepositBreakdown({ events, currency }: { events: RampActivityEvent[]; currency: string }) {
  const received = [...events].reverse().find(e => e.type === 'payment_processed')
  // Any source-side event carries the pre-fee fiat amount.
  const sourceEv = [...events].reverse().find(e =>
    e.type === 'funds_received' || e.type === 'payment_submitted' || e.type === 'in_review')
  const feeCarrier = received ?? sourceEv

  const sent      = fmtAmount(sourceEv?.amount)
  const recvAmt   = fmtAmount(received?.amount ?? received?.receipt?.final_amount)
  const fees      = feeCarrier ? sumFees(feeCarrier) : 0
  const gas       = Number(received?.gas_fee ?? received?.receipt?.gas_fee ?? 0)

  // Nothing to show until at least a source amount exists.
  if (!sent && !recvAmt) return null

  const cur = (currency || sourceEv?.currency || 'usd').toUpperCase()

  return (
    <div className="space-y-2 rounded-xl border border-app-border/60 bg-app-bg p-3.5 text-sm">
      <p className="text-[11px] font-medium uppercase tracking-wide text-app-muted">Breakdown</p>

      <Row label="You send" value={sent ? `${sent} ${cur}` : 'Waiting…'} muted={!sent} />

      <Row
        label="Fees"
        value={
          <span className="inline-flex items-center gap-1.5">
            <span>{fees > 0 ? `${fmtAmount(String(fees))} ${cur}` : `0.00 ${cur}`}</span>
            <span className="rounded-full bg-emerald-900/40 px-1.5 py-0.5 text-[10px] font-medium text-emerald-400">
              0% at launch
            </span>
          </span>
        }
      />

      {gas > 0 && (
        <Row label="Network fee" value={`${fmtAmount(String(gas))} USDC`} />
      )}

      <div className="my-1 h-px bg-app-border/60" />

      <Row
        label="You receive"
        value={recvAmt ? `${recvAmt} USDC` : 'Pending…'}
        muted={!recvAmt}
        emphasis={!!recvAmt}
      />
      {recvAmt && (
        <p className="text-[11px] text-app-muted">Delivered to your wallet on Base.</p>
      )}
    </div>
  )
}

function Row({ label, value, muted, emphasis }: {
  label: string; value: React.ReactNode; muted?: boolean; emphasis?: boolean
}) {
  return (
    <div className="flex items-center justify-between gap-3">
      <span className="text-app-muted">{label}</span>
      <span className={`${emphasis ? 'font-semibold text-app-text' : muted ? 'text-app-muted' : 'text-app-text'}`}>
        {value}
      </span>
    </div>
  )
}

function DepositTracker({ currency }: { currency: string }) {
  const { getActivity } = useOnramp()
  const [events, setEvents]   = useState<RampActivityEvent[]>([])
  const [loading, setLoading] = useState(true)
  const [refreshing, setRefreshing] = useState(false)
  const timer = useRef<ReturnType<typeof setInterval> | null>(null)

  const pull = async () => {
    const r = await getActivity(currency)
    if (r) setEvents(r.events)
    setLoading(false)
  }

  useEffect(() => {
    pull()
    // Poll while the page is open; deposits can take minutes to hours.
    timer.current = setInterval(pull, 15000)
    const onFocus = () => pull()
    window.addEventListener('focus', onFocus)
    return () => {
      if (timer.current) clearInterval(timer.current)
      window.removeEventListener('focus', onFocus)
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [currency])

  const manualRefresh = async () => { setRefreshing(true); await pull(); setRefreshing(false) }

  const idx = stageIndexFor(events)
  const delivered = idx >= TRACKER_STEPS.length - 1
  const disposition = dispositionFor(events)
  const processed = [...events].reverse().find(e => e.type === 'payment_processed')

  return (
    <div className="space-y-4 rounded-2xl border border-app-border bg-app-surface p-5">
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-2 text-app-text">
          <Clock className="h-4 w-4 text-app-accent-text" />
          <span className="text-sm font-medium">Deposit status</span>
        </div>
        <button onClick={manualRefresh} disabled={refreshing}
          className="inline-flex items-center gap-1 text-[11px] text-app-muted transition-colors hover:text-app-text disabled:opacity-50">
          <RefreshCw className={`h-3 w-3 ${refreshing ? 'animate-spin' : ''}`} /> Refresh
        </button>
      </div>

      {loading ? (
        <div className="h-28 animate-pulse rounded-lg bg-app-bg" />
      ) : disposition.kind === 'returned' ? (
        <StatusBanner
          tone={disposition.failed ? 'failed' : 'returned'}
          title={disposition.failed ? 'Return failed' : 'Deposit returned to sender'}
          body={disposition.failed
            ? `We couldn’t complete the return of this deposit. Please contact support so we can help.${disposition.reason ? ` Reason: ${disposition.reason}.` : ''}`
            : `This deposit is being returned to the bank account it came from${disposition.reason ? ` (${disposition.reason})` : ''}. No USDC will be delivered for it.`}
        />
      ) : disposition.kind === 'microdeposit' ? (
        <StatusBanner
          tone="info"
          title="Verification deposit received"
          body="This was a small verification deposit (under $1), not a full deposit — it won’t be converted to USDC on its own. Send your full amount to complete an on-ramp."
        />
      ) : (
        <>
          {disposition.kind === 'in_review' && (
            <StatusBanner
              tone="review"
              title="Deposit under review"
              body="Your deposit arrived and is going through a routine compliance check. This usually clears on its own — no action needed. We’ll update the status here."
            />
          )}
          <ol className="relative space-y-4">
            {TRACKER_STEPS.map((step, i) => {
              const done    = i < idx || (delivered && i <= idx)
              const current = i === idx && !delivered && disposition.kind === 'normal'
              return (
                <li key={step.key} className="flex items-start gap-3">
                  <span className="relative flex flex-col items-center">
                    <span className={`flex h-6 w-6 items-center justify-center rounded-full border text-[11px] ${
                      done
                        ? 'border-emerald-500 bg-emerald-500 text-white'
                        : current
                          ? 'border-app-accent bg-app-accent/15 text-app-accent-text'
                          : 'border-app-border text-app-muted'}`}>
                      {done ? <Check className="h-3.5 w-3.5" />
                            : current ? <Loader2 className="h-3 w-3 animate-spin" />
                            : i + 1}
                    </span>
                    {i < TRACKER_STEPS.length - 1 && (
                      <span className={`mt-1 h-6 w-px ${i < idx ? 'bg-emerald-500/60' : 'bg-app-border'}`} />
                    )}
                  </span>
                  <div className="pt-0.5">
                    <p className={`text-sm ${done || current ? 'text-app-text' : 'text-app-muted'}`}>
                      {step.label}
                    </p>
                    {current && i === 0 && (
                      <p className="text-[11px] text-app-muted">
                        Send {currency.toUpperCase()} using the details above — this updates on its own.
                      </p>
                    )}
                  </div>
                </li>
              )
            })}
          </ol>
          <DepositBreakdown events={events} currency={currency} />
        </>
      )}

      {delivered && processed?.receipt?.url && (
        <a href={processed.receipt.url} target="_blank" rel="noopener noreferrer"
          className="inline-flex items-center gap-1 text-xs text-app-accent-text hover:underline">
          View receipt <ExternalLink className="h-3 w-3" />
        </a>
      )}

      {!loading && events.length === 0 && (
        <p className="text-[11px] text-app-muted">
          No deposits yet. Once you send funds, they&rsquo;ll show here.
        </p>
      )}
    </div>
  )
}

export default function RampPage() {
  return (
    <SectionGuard section="ramp">
      <RampInner />
    </SectionGuard>
  )
}
