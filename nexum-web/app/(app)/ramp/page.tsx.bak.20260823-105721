'use client'
import { SectionGuard } from '@/components/layout/SectionGuard'
import { useState, useEffect, useRef } from 'react'
import {
  useRamp, useOnramp, useOfframp,
  type RampCustomerType, type RampCorridor, type RampVirtualAccount,
  type DepositInstructions, type RampActivityEvent,
  type RampExternalAccount, type RampLiquidationAddress, type RampDrain,
  type OfframpBankDetail, type RegisterBankParams,
} from '@/hooks/useRamp'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Badge } from '@/components/ui/badge'
import {
  ArrowDownUp, ShieldCheck, Loader2, ExternalLink, AlertCircle,
  CheckCircle, Clock, Building2, User as UserIcon,
  Copy, Check, ChevronLeft, Landmark, Wallet, ArrowRight, RefreshCw,
  ArrowDownToLine, ArrowUpFromLine, Banknote, Send as SendIcon, CircleCheck,
} from 'lucide-react'
import { sendUsdc, UserCancelledError, NeedsReauthError } from '@/hooks/useCircleTx'

const IS_SANDBOX = process.env.NEXT_PUBLIC_RAMP_ENV !== 'production'

function RampInner() {
  const {
    customer, loading, busy, error, verified,
    startVerification, refresh, simulateApprove,
  } = useRamp()

  const [fullName, setFullName] = useState('')
  const [type, setType]         = useState<RampCustomerType>('individual')
  const pollRef = useRef<ReturnType<typeof setInterval> | null>(null)

  const status = customer?.kycStatus
  const inProgress = customer?.exists && !verified &&
    status !== 'rejected' && status !== 'offboarded'

  // While the user is completing the hosted flow, poll for status. Also refresh
  // when they come back to this tab (they finish KYC in a new tab).
  useEffect(() => {
    if (!inProgress) return
    pollRef.current = setInterval(refresh, 8000)
    const onFocus = () => refresh()
    window.addEventListener('focus', onFocus)
    return () => {
      if (pollRef.current) clearInterval(pollRef.current)
      window.removeEventListener('focus', onFocus)
    }
  }, [inProgress, refresh])

  const header = (
    <div className="mb-6">
      <h1 className="flex items-center gap-2 text-xl font-semibold text-app-text">
        <ArrowDownUp className="h-5 w-5 text-app-accent-text" /> On/Off-ramp
      </h1>
      <p className="text-sm text-app-muted">
        Move money between your bank and USDC. Verify your identity once to get started.
      </p>
    </div>
  )

  if (loading) {
    return (
      <div>
        {header}
        <div className="w-full max-w-md rounded-2xl border border-app-border bg-app-surface p-5">
          <div className="h-24 animate-pulse rounded-lg bg-app-border" />
        </div>
      </div>
    )
  }

  // --- Verified: on-ramp / off-ramp, chosen by the direction toggle ----------
  if (verified) {
    return (
      <div>
        {header}
        <RampSwitcher />
      </div>
    )
  }

  // --- Rejected: show reasons + allow retry ----------------------------------
  if (customer?.exists && (status === 'rejected' || status === 'offboarded')) {
    return (
      <div>
        {header}
        <div className="w-full max-w-md space-y-3 rounded-2xl border border-app-border bg-app-surface p-5">
          <div className="flex items-center gap-2 text-red-400">
            <AlertCircle className="h-5 w-5" />
            <span className="font-medium">Verification didn&rsquo;t pass</span>
          </div>
          {customer.rejectionReasons && customer.rejectionReasons.length > 0 && (
            <ul className="space-y-1 text-sm text-app-muted">
              {customer.rejectionReasons.map((r, i) => (
                <li key={i}>• {r.reason ?? r.developer_reason ?? 'Verification issue'}</li>
              ))}
            </ul>
          )}
          {customer.kycLink && (
            <a href={customer.kycLink} target="_blank" rel="noopener noreferrer">
              <Button className="w-full">
                <ExternalLink className="h-4 w-4" /> Try verification again
              </Button>
            </a>
          )}
        </div>
      </div>
    )
  }

  // --- In progress: hosted links + live status -------------------------------
  if (inProgress) {
    const tosDone = customer?.tosStatus === 'approved'
    return (
      <div>
        {header}
        <div className="w-full max-w-md space-y-4 rounded-2xl border border-app-border bg-app-surface p-5">
          <div className="flex items-center gap-2 text-app-text">
            <Clock className="h-5 w-5 text-amber-400" />
            <span className="font-medium">Verification in progress</span>
          </div>
          <p className="text-sm text-app-muted">
            Complete these two steps in the new tab. This page updates automatically.
          </p>

          {/* Step 1: Terms of Service */}
          <div className="flex items-center justify-between rounded-lg border border-app-border p-3">
            <div className="flex items-center gap-2 text-sm">
              {tosDone
                ? <CheckCircle className="h-4 w-4 text-emerald-400" />
                : <span className="h-4 w-4 rounded-full border border-app-muted" />}
              <span className={tosDone ? 'text-app-muted line-through' : 'text-app-text'}>
                Accept Terms of Service
              </span>
            </div>
            {!tosDone && customer?.tosLink && (
              <a href={customer.tosLink} target="_blank" rel="noopener noreferrer"
                className="text-xs text-app-accent-text hover:underline">
                Open <ExternalLink className="inline h-3 w-3" />
              </a>
            )}
          </div>

          {/* Step 2: Identity verification */}
          <div className="flex items-center justify-between rounded-lg border border-app-border p-3">
            <div className="flex items-center gap-2 text-sm">
              <span className="h-4 w-4 rounded-full border border-app-muted" />
              <span className="text-app-text">Verify your identity</span>
            </div>
            {customer?.kycLink && (
              <a href={customer.kycLink} target="_blank" rel="noopener noreferrer"
                className="text-xs text-app-accent-text hover:underline">
                Open <ExternalLink className="inline h-3 w-3" />
              </a>
            )}
          </div>

          <div className="flex items-center gap-1.5 text-xs text-app-muted">
            <Loader2 className="h-3 w-3 animate-spin" /> Checking status…
            <span className="ml-1">({status?.replace(/_/g, ' ')})</span>
          </div>

          {IS_SANDBOX && customer?.customerId && (
            <Button variant="outline" className="w-full" disabled={busy}
              onClick={() => simulateApprove()}>
              {busy ? <Loader2 className="h-4 w-4 animate-spin" /> : null}
              Sandbox: simulate approval
            </Button>
          )}
        </div>
      </div>
    )
  }

  // --- Not started: onboarding form ------------------------------------------
  return (
    <div>
      {header}
      <div className="w-full max-w-md space-y-4 rounded-2xl border border-app-border bg-app-surface p-5">
        <div className="flex items-center gap-2 text-app-text">
          <ShieldCheck className="h-5 w-5 text-app-accent-text" />
          <span className="font-medium">Verify your identity</span>
        </div>
        <p className="text-sm text-app-muted">
          On/off-ramp moves real money, so we verify you first. It takes about a
          minute and is handled securely by our partner.
        </p>

        {/* Account type */}
        <div className="space-y-2">
          <label className="text-xs font-medium uppercase tracking-wider text-app-muted">
            Account type
          </label>
          <div className="grid grid-cols-2 gap-2">
            <button
              onClick={() => setType('individual')}
              className={`flex items-center justify-center gap-2 rounded-lg border p-3 text-sm ${
                type === 'individual'
                  ? 'border-app-accent bg-app-bg text-app-text'
                  : 'border-app-border text-app-muted'}`}>
              <UserIcon className="h-4 w-4" /> Individual
            </button>
            <button
              onClick={() => setType('business')}
              className={`flex items-center justify-center gap-2 rounded-lg border p-3 text-sm ${
                type === 'business'
                  ? 'border-app-accent bg-app-bg text-app-text'
                  : 'border-app-border text-app-muted'}`}>
              <Building2 className="h-4 w-4" /> Business
            </button>
          </div>
        </div>

        {/* Legal name */}
        <div className="space-y-2">
          <label className="text-xs font-medium uppercase tracking-wider text-app-muted">
            {type === 'business' ? 'Legal business name' : 'Full legal name'}
          </label>
          <Input
            placeholder={type === 'business' ? 'Acme Inc.' : 'John Doe'}
            value={fullName}
            onChange={e => setFullName(e.target.value)}
          />
        </div>

        {error && (
          <div className="flex items-start gap-1.5 rounded-lg bg-red-900/20 px-3 py-2 text-xs text-red-400">
            <AlertCircle className="mt-0.5 h-3.5 w-3.5 shrink-0" />
            <span>{error}</span>
          </div>
        )}

        <Button className="w-full" size="lg" disabled={busy || !fullName.trim()}
          onClick={async () => {
            const c = await startVerification(fullName.trim(), type)
            // Open the ToS link immediately so the user starts the hosted flow.
            if (c?.tosLink) window.open(c.tosLink, '_blank', 'noopener')
          }}>
          {busy
            ? <><Loader2 className="h-4 w-4 animate-spin" /> Starting…</>
            : 'Start verification'}
        </Button>
      </div>
    </div>
  )
}

// ═══════════════════════════════════════════════════════════════════════════
// Direction switcher — on-ramp (add money) vs off-ramp (withdraw). The two are
// mirror images: on-ramp brings fiat in as USDC; off-ramp sends USDC out as
// fiat. The toggle makes that symmetry the organizing idea of the page.
// ═══════════════════════════════════════════════════════════════════════════

type Direction = 'onramp' | 'offramp'

function RampSwitcher() {
  const [direction, setDirection] = useState<Direction>('onramp')
  return (
    <div className="w-full max-w-lg">
      <DirectionToggle value={direction} onChange={setDirection} />
      {direction === 'onramp' ? <OnrampFlow /> : <OfframpFlow />}
    </div>
  )
}

function DirectionToggle({ value, onChange }: {
  value: Direction; onChange: (d: Direction) => void
}) {
  const opts: Array<{ key: Direction; label: string; sub: string; Icon: typeof ArrowDownToLine }> = [
    { key: 'onramp',  label: 'Add money', sub: 'Bank → USDC', Icon: ArrowDownToLine },
    { key: 'offramp', label: 'Withdraw',  sub: 'USDC → Bank', Icon: ArrowUpFromLine },
  ]
  return (
    <div className="mb-5 grid grid-cols-2 gap-1 rounded-2xl border border-app-border bg-app-surface p-1">
      {opts.map(({ key, label, sub, Icon }) => {
        const active = value === key
        return (
          <button key={key} onClick={() => onChange(key)}
            aria-pressed={active}
            className={`flex items-center justify-center gap-2.5 rounded-xl px-4 py-3 text-left transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-app-accent/50 ${
              active
                ? 'bg-app-accent/15 text-app-text shadow-sm ring-1 ring-app-accent/40'
                : 'text-app-muted hover:bg-app-bg hover:text-app-text'}`}>
            <Icon className={`h-5 w-5 shrink-0 ${active ? 'text-app-accent-text' : ''}`} />
            <span className="leading-tight">
              <span className="block text-sm font-medium">{label}</span>
              <span className="block text-[11px] opacity-80">{sub}</span>
            </span>
          </button>
        )
      })}
    </div>
  )
}

// ═══════════════════════════════════════════════════════════════════════════
// Off-ramp flow (verified users). Currency grid → bank details → withdraw +
// drain tracker. USDC leaves the user's Circle wallet on Base to a Bridge
// liquidation address; Bridge pays out fiat to the registered bank account.
// ═══════════════════════════════════════════════════════════════════════════

// The bank-detail fields each currency needs, mirroring Bridge's external-
// account shapes. Only these three currencies have off-ramp rails at launch.
const OFFRAMP_RAIL_LABEL: Record<string, string> = {
  usd: 'ACH transfer',
  eur: 'SEPA transfer',
  mxn: 'SPEI transfer',
}

type OffStage = 'pick' | 'bank' | 'withdraw'

function OfframpFlow() {
  const {
    corridors, corridorsLoading, endorsementFor,
    findExternalAccount, findLiquidationAddress,
    busy, error,
    registerBank, createLiquidationAddress,
    loadExternalAccounts, loadLiquidationAddresses,
  } = useOfframp()

  const [stage, setStage]       = useState<OffStage>('pick')
  const [selected, setSelected] = useState<string | null>(null)
  const [liqAddr, setLiqAddr]   = useState<RampLiquidationAddress | null>(null)

  const pick = (currency: string) => {
    if (endorsementFor(currency) !== 'approved') return
    setSelected(currency)
    const existingLiq  = findLiquidationAddress(currency)
    const existingBank = findExternalAccount(currency)
    if (existingLiq)  { setLiqAddr(existingLiq); setStage('withdraw'); return }
    if (existingBank) { setStage('bank'); return } // bank set, address not yet — bank step will fast-forward
    setStage('bank')
  }

  // Called by the bank form when the account is registered → create the
  // liquidation address, then move to the withdraw step.
  const onBankReady = async () => {
    if (!selected) return
    const la = await createLiquidationAddress(selected)
    if (la) { setLiqAddr(la); setStage('withdraw') }
  }

  const back = () => {
    if (stage === 'withdraw') { setStage('pick'); setLiqAddr(null); setSelected(null); loadLiquidationAddresses() }
    else if (stage === 'bank') { setStage('pick'); setSelected(null); loadExternalAccounts() }
  }

  if (stage === 'withdraw' && liqAddr) {
    return <WithdrawView liq={liqAddr} onBack={back} />
  }

  if (stage === 'bank' && selected) {
    return (
      <BankDetailsForm
        currency={selected}
        existing={findExternalAccount(selected)}
        busy={busy}
        error={error}
        onBack={back}
        onRegister={registerBank}
        onReady={onBankReady}
      />
    )
  }

  // stage === 'pick'
  return (
    <div>
      <div className="mb-4">
        <h2 className="text-sm font-medium text-app-text">Withdraw to your bank</h2>
        <p className="text-sm text-app-muted">Choose the currency you&rsquo;d like to receive.</p>
      </div>

      {corridorsLoading ? (
        <div className="grid grid-cols-2 gap-3 sm:grid-cols-3">
          {Array.from({ length: 3 }).map((_, i) => (
            <div key={i} className="h-24 animate-pulse rounded-xl border border-app-border bg-app-surface" />
          ))}
        </div>
      ) : corridors.length === 0 ? (
        <div className="rounded-2xl border border-app-border bg-app-surface p-6 text-sm text-app-muted">
          No withdrawal currencies are available right now. Please check back soon.
        </div>
      ) : (
        <div className="grid grid-cols-2 gap-3 sm:grid-cols-3">
          {corridors.map((c: RampCorridor) => {
            const m = meta(c.currency)
            const hasBank = !!findExternalAccount(c.currency)
            const endo = endorsementFor(c.currency)
            const enabled = endo === 'approved'
            return (
              <button key={c.currency}
                onClick={() => pick(c.currency)}
                disabled={!enabled}
                aria-disabled={!enabled}
                className={`group relative flex flex-col items-start gap-2 rounded-xl border p-4 text-left transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-app-accent/50 ${
                  enabled
                    ? 'border-app-border bg-app-surface hover:border-app-accent/60 hover:bg-app-bg cursor-pointer'
                    : 'border-app-border/60 bg-app-surface/50 cursor-not-allowed'}`}>
                <span className={`text-2xl leading-none ${enabled ? '' : 'opacity-40 grayscale'}`} aria-hidden>{m.flag}</span>
                <span className={`text-sm font-medium ${enabled ? 'text-app-text' : 'text-app-muted'}`}>{c.currency.toUpperCase()}</span>
                <span className="text-[11px] leading-tight text-app-muted">{m.name}</span>
                {enabled && hasBank && (
                  <span className="absolute right-2 top-2 flex items-center gap-0.5 rounded-full bg-emerald-900/40 px-1.5 py-0.5 text-[9px] font-medium text-emerald-400">
                    <Check className="h-2.5 w-2.5" /> Linked
                  </span>
                )}
                {enabled && !hasBank && (
                  <ArrowRight className="absolute bottom-3 right-3 h-4 w-4 text-app-muted opacity-0 transition-opacity group-hover:opacity-100" />
                )}
                {!enabled && (
                  <span className="absolute right-2 top-2 rounded-full bg-app-border px-1.5 py-0.5 text-[9px] font-medium text-app-muted">
                    {endo === 'pending' ? 'In review' : 'Soon'}
                  </span>
                )}
              </button>
            )
          })}
        </div>
      )}

      {!corridorsLoading && corridors.some(c => endorsementFor(c.currency) !== 'approved') && (
        <p className="mt-3 flex items-start gap-1.5 text-[11px] text-app-muted">
          <AlertCircle className="mt-0.5 h-3 w-3 shrink-0" />
          Greyed-out currencies need extra approval from our payments partner before you can withdraw them. We&rsquo;re working on it.
        </p>
      )}
    </div>
  )
}

// ── Bank details form (currency-branched) ──────────────────────────────────

function BankDetailsForm({ currency, existing, busy, error, onBack, onRegister, onReady }: {
  currency: string
  existing: RampExternalAccount | null
  busy: boolean
  error: string | null
  onBack: () => void
  onRegister: (p: RegisterBankParams) => Promise<RampExternalAccount | null>
  onReady: () => Promise<void>
}) {
  const m = meta(currency)
  const railLabel = OFFRAMP_RAIL_LABEL[currency] ?? 'Bank transfer'

  // Shared identity + address.
  const [holderName, setHolderName] = useState('')
  const [bankName,   setBankName]   = useState('')
  const [line1, setLine1] = useState('')
  const [city,  setCity]  = useState('')
  const [region, setRegion] = useState('')
  const [postal, setPostal] = useState('')
  const [country, setCountry] = useState(currency === 'usd' ? 'USA' : currency === 'mxn' ? 'MEX' : '')

  // US
  const [routing, setRouting] = useState('')
  const [account, setAccount] = useState('')
  const [accType, setAccType] = useState<'checking' | 'savings'>('checking')
  // EUR
  const [iban, setIban] = useState('')
  const [bic, setBic]   = useState('')
  const [ibanCountry, setIbanCountry] = useState('')
  // MXN
  const [clabe, setClabe] = useState('')

  const [localErr, setLocalErr] = useState<string | null>(null)
  const [linking, setLinking]   = useState(false)

  // If a bank account is already registered, skip straight to creating the
  // liquidation address (no need to re-enter details).
  const skipToWithdraw = async () => { setLinking(true); await onReady(); setLinking(false) }

  const detailValid = (): boolean => {
    if (currency === 'usd') return !!routing.trim() && !!account.trim()
    if (currency === 'eur') return !!iban.trim() && !!bic.trim() && !!ibanCountry.trim()
    if (currency === 'mxn') return !!clabe.trim()
    return false
  }
  const baseValid = !!holderName.trim() && !!line1.trim() && !!city.trim() && !!postal.trim() && !!country.trim()
  const valid = baseValid && detailValid()

  const submit = async () => {
    setLocalErr(null)
    if (!valid) { setLocalErr('Please fill in all required fields.'); return }
    let detail: OfframpBankDetail
    if (currency === 'usd') {
      detail = { kind: 'us', routingNumber: routing.trim(), accountNumber: account.trim(), checkingOrSavings: accType }
    } else if (currency === 'eur') {
      detail = { kind: 'iban', ibanNumber: iban.trim(), bic: bic.trim(), country: ibanCountry.trim().toUpperCase() }
    } else {
      detail = { kind: 'clabe', clabeNumber: clabe.trim() }
    }
    const acct = await onRegister({
      currency,
      accountOwnerName: holderName.trim(),
      accountOwnerType: 'individual',
      bankName: bankName.trim() || undefined,
      address: {
        street_line_1: line1.trim(),
        city: city.trim(),
        state: region.trim() || undefined,
        postal_code: postal.trim(),
        country: country.trim().toUpperCase(),
      },
      detail,
    })
    if (acct) { setLinking(true); await onReady(); setLinking(false) }
  }

  return (
    <div>
      <button onClick={onBack}
        className="mb-4 inline-flex items-center gap-1 text-sm text-app-muted transition-colors hover:text-app-text">
        <ChevronLeft className="h-4 w-4" /> All currencies
      </button>

      <div className="space-y-5 rounded-2xl border border-app-border bg-app-surface p-6">
        <div className="flex items-center gap-3">
          <span className="text-3xl leading-none" aria-hidden>{m.flag}</span>
          <div>
            <p className="font-medium text-app-text">Withdraw {m.name}</p>
            <p className="text-sm text-app-muted">Paid out by {railLabel}</p>
          </div>
        </div>

        {existing ? (
          // Already have a linked account for this currency.
          <>
            <div className="flex items-center justify-between rounded-xl border border-app-border bg-app-bg p-4">
              <div className="flex items-center gap-3">
                <Banknote className="h-5 w-5 text-app-accent-text" />
                <div className="text-sm">
                  <p className="text-app-text">{existing.bankName ?? 'Bank account'}</p>
                  <p className="font-mono text-[11px] text-app-muted">
                    {existing.last4 ? `•••• ${existing.last4}` : 'Linked'}
                  </p>
                </div>
              </div>
              <Badge variant="success">Linked</Badge>
            </div>
            <Button className="w-full" size="lg" disabled={linking} onClick={skipToWithdraw}>
              {linking
                ? <><Loader2 className="h-4 w-4 animate-spin" /> Preparing…</>
                : <>Continue to withdraw <ArrowRight className="h-4 w-4" /></>}
            </Button>
          </>
        ) : (
          <>
            <p className="text-sm text-app-muted">
              Add the bank account you&rsquo;d like to receive {currency.toUpperCase()} in. Your details go
              straight to our payments partner &mdash; Nexum never stores your account number.
            </p>

            <Field label="Account holder name">
              <Input placeholder="John Doe" value={holderName} onChange={e => setHolderName(e.target.value)} />
            </Field>
            <Field label="Bank name" optional>
              <Input placeholder={currency === 'usd' ? 'Lead Bank' : 'Your bank'} value={bankName} onChange={e => setBankName(e.target.value)} />
            </Field>

            {/* Currency-specific account fields */}
            {currency === 'usd' && (
              <div className="grid grid-cols-2 gap-3">
                <Field label="Routing number">
                  <Input inputMode="numeric" placeholder="101019644" value={routing} onChange={e => setRouting(e.target.value)} />
                </Field>
                <Field label="Account number">
                  <Input inputMode="numeric" placeholder="215268129123" value={account} onChange={e => setAccount(e.target.value)} />
                </Field>
                <div className="col-span-2">
                  <label className="mb-2 block text-xs font-medium uppercase tracking-wider text-app-muted">Account type</label>
                  <div className="grid grid-cols-2 gap-2">
                    {(['checking', 'savings'] as const).map(t => (
                      <button key={t} onClick={() => setAccType(t)}
                        className={`rounded-lg border p-2.5 text-sm capitalize transition-colors ${
                          accType === t ? 'border-app-accent bg-app-bg text-app-text' : 'border-app-border text-app-muted'}`}>
                        {t}
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            )}
            {currency === 'eur' && (
              <div className="grid grid-cols-2 gap-3">
                <div className="col-span-2">
                  <Field label="IBAN">
                    <Input placeholder="IE26MODR99035507970528" value={iban} onChange={e => setIban(e.target.value)} />
                  </Field>
                </div>
                <Field label="BIC / SWIFT">
                  <Input placeholder="MODRIE22XXX" value={bic} onChange={e => setBic(e.target.value)} />
                </Field>
                <Field label="Bank country">
                  <Input placeholder="IRL" value={ibanCountry} onChange={e => setIbanCountry(e.target.value)} />
                </Field>
              </div>
            )}
            {currency === 'mxn' && (
              <Field label="CLABE">
                <Input inputMode="numeric" placeholder="646180157000000004" value={clabe} onChange={e => setClabe(e.target.value)} />
              </Field>
            )}

            {/* Billing address */}
